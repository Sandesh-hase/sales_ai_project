    {
      "id": "CqaFUatBIUr_gpu7CZIIa",
      "type": "text",
      "x": -3465.908553883471,
      "y": 733.8905009514383,
      "width": 843.399527417455,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCx",
      "roundness": null,
      "seed": 850202156,
      "version": 216,
      "versionNonce": 1226962899,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789630027057,
      "link": null,
      "locked": false,
      "text": "Data Model Relationships:\n\nsales_transactions is the fact table (center of the model). Every other\ntable connects into it.\n\nproducts → sales_transactions: One-to-Many (1:N). One product can appear in\nmany sales transactions, but each transaction row points to exactly one\nproduct. Linked via product_id.\n\nstores → sales_transactions: One-to-Many (1:N). One store can have many\nsales transactions, but each transaction happened at exactly one store.\nLinked via store_id.\n\ncalendar_marketing_external → sales_transactions: One-to-Many (1:N). One\ncalendar date (with its holiday/weather/marketing context) can apply to many\nsales transactions that day, but each transaction has exactly one date.\nLinked via date.\n\nproducts, stores, calendar_marketing_external are not related to each other\ndirectly — they only connect through sales_transactions. This is why it's\ncalled a star schema: one fact table in the middle, dimension tables\nradiating out around it.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data Model Relationships:\n\nsales_transactions is the fact table (center of the model). Every other table connects into it.\n\nproducts → sales_transactions: One-to-Many (1:N). One product can appear in many sales transactions, but each transaction row points to exactly one product. Linked via product_id.\n\nstores → sales_transactions: One-to-Many (1:N). One store can have many sales transactions, but each transaction happened at exactly one store. Linked via store_id.\n\ncalendar_marketing_external → sales_transactions: One-to-Many (1:N). One calendar date (with its holiday/weather/marketing context) can apply to many sales transactions that day, but each transaction has exactly one date. Linked via date.\n\nproducts, stores, calendar_marketing_external are not related to each other directly — they only connect through sales_transactions. This is why it's called a star schema: one fact table in the middle, dimension tables radiating out around it.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1789589105192,
      "baseFontSize": null
    },
