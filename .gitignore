# Root level gitignore

# Environment variables
.env
.env.local
.env.*.local

# Dependencies lock files (if they should be ignored - typically commit these)
# uv.lock
# package-lock.json

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# Node
node_modules/

# Logs
*.log
logs/
